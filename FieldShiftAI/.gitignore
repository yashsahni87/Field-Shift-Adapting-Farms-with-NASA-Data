```gitignore
# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/
.venv/
env/
.env

# Streamlit
.streamlit/secrets.toml

# Environment variables
.env
.env.*

# IDE / Editor
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Python packaging
build/
dist/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Temporary files
*.tmp
*.temp
```
